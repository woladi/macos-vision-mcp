{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.woladi/macos-vision-mcp",
  "description": "Local OCR & screen understanding for agents: read any window, find what to click. No uploads.",
  "repository": {
    "url": "https://github.com/woladi/macos-vision-mcp",
    "source": "github"
  },
  "version": "0.7.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "macos-vision-mcp",
      "version": "0.7.0",
      "runtimeHints": {
        "os": ["darwin"]
      },
      "transport": {
        "type": "stdio"
      }
    }
  ],
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/woladi/macos-vision-mcp/master/.github/assets/logo.svg",
      "mimeType": "image/svg+xml",
      "sizes": ["any"]
    },
    {
      "src": "https://raw.githubusercontent.com/woladi/macos-vision-mcp/master/.github/assets/logo-512.png",
      "mimeType": "image/png",
      "sizes": ["512x512"]
    },
    {
      "src": "https://raw.githubusercontent.com/woladi/macos-vision-mcp/master/.github/assets/logo-128.png",
      "mimeType": "image/png",
      "sizes": ["128x128"]
    },
    {
      "src": "https://raw.githubusercontent.com/woladi/macos-vision-mcp/master/.github/assets/logo-32.png",
      "mimeType": "image/png",
      "sizes": ["32x32"]
    }
  ]
}
