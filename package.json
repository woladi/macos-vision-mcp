{
  "name": "macos-vision-mcp",
  "mcpName": "io.github.woladi/macos-vision-mcp",
  "version": "0.6.5",
  "description": "Local OCR and on-device screen reading for MCP clients (Claude, Cursor): read any window, locate elements to click, assert what's on screen. Apple Vision, no API keys, nothing uploaded.",
  "type": "module",
  "bin": {
    "macos-vision-mcp": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woladi/macos-vision-mcp.git"
  },
  "homepage": "https://github.com/woladi/macos-vision-mcp#readme",
  "bugs": {
    "url": "https://github.com/woladi/macos-vision-mcp/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0",
    "os": [
      "darwin"
    ]
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "ocr",
    "pdf",
    "pdf-ocr",
    "image-to-text",
    "text-extraction",
    "apple-vision",
    "vision-framework",
    "macos",
    "barcode",
    "qr-code",
    "face-detection",
    "image-classification",
    "document-detection",
    "screenshot",
    "claude",
    "claude-desktop",
    "cursor",
    "offline",
    "computer-use",
    "ui-automation",
    "ui-testing",
    "desktop-automation",
    "accessibility",
    "ai-agent",
    "screen-capture",
    "on-device",
    "privacy"
  ],
  "author": "Adrian Wolczuk",
  "license": "MIT",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src test",
    "test": "vitest run",
    "format": "prettier --write .",
    "prepare": "npm run build && husky",
    "changeset": "changeset",
    "sync-version": "node scripts/sync-version.js",
    "version-packages": "changeset version && node scripts/sync-version.js",
    "release": "npm run build && changeset publish"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "macos-vision": "^1.8.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/node": "^20.0.0",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.58.0",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
